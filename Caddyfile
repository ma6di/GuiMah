# =============================================================================
# GuiMah Studio — Caddy config
#
# Caddy auto-provisions HTTPS via Let's Encrypt as soon as this Caddyfile
# resolves a public hostname on ports 80/443. For local dev use `localhost` —
# Caddy trusts its own internal CA and no ACME calls happen.
#
# When you deploy, set SITE_ADDRESS in the environment to your real domain
# (e.g. `SITE_ADDRESS=guimah.studio`). Nothing else needs to change.
# =============================================================================

{
	# Uncomment on first prod deploy to see ACME progress in the container log.
	# debug

	# Real email so Let's Encrypt can warn about expiring accounts.
	email guimahstudio@gmail.com
}

{$SITE_ADDRESS:localhost} {
	root * /srv
	encode zstd gzip

	# --- security headers -----------------------------------------------------
	# Applied to every response, not just the HTML — CSS/JS/images benefit too.
	header {
		# Force HTTPS for a year across all subdomains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# We don't use any browser features that need explicit permission.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# CSP: same-origin assets + Formspree POST target.
		# Fonts are self-hosted — no Google Fonts domains needed.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; upgrade-insecure-requests"
		# The nginx-style server signature isn't useful and gives free recon.
		-Server
	}

	# --- caching --------------------------------------------------------------
	# Vite's asset filenames look like main-CRd0yK-N.css — hyphens, underscores
	# and mixed case are all in the hash, so match on the /assets/ prefix
	# rather than trying to spot hex-only fingerprints.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate — that's how new deploys reach visitors.
	@html path *.html /
	header @html Cache-Control "no-cache, must-revalidate"

	# --- routing --------------------------------------------------------------
	# Static site — no client routing, so an unknown path should 404 rather
	# than silently serve index.html (which would break analytics + SEO).
	file_server
}

# =============================================================================
# Internal health endpoint
#
# Loopback-only and plain HTTP on purpose. The Docker healthcheck must not go
# through the public site block: once SITE_ADDRESS is a real domain, a request
# to http://localhost/ gets a 308 to https://localhost/, where the TLS
# handshake fails because Caddy only holds a certificate for the real domain.
# The container then reports unhealthy forever while serving traffic perfectly.
#
# Serving the real index.html from /srv means this also fails loudly if the
# built site is missing from the image, not just if Caddy is down.
# =============================================================================
http://127.0.0.1:8081 {
	root * /srv
	rewrite * /index.html
	file_server
}
